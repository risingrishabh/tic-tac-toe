<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>I'm Sorry 🥺 — From Rishabh</title>
<meta name="description" content="A heartfelt apology from Rishabh." />
<meta name="theme-color" content="#1c1b3a" />

<!-- Fonts are optional: if they fail to load, system fallbacks are used. -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

<style>
/* =========================================================
   1. THEME TOKENS
   ========================================================= */
:root {
  --night-1: #12142b;
  --night-2: #221f45;
  --night-3: #3a2d5c;
  --mist: #b8b2e0;
  --text: #f1edff;
  --text-soft: #cfc8ef;
  --rose: #ff8fab;
  --rose-deep: #e05a83;
  --glass: rgba(255, 255, 255, .08);
  --glass-border: rgba(255, 255, 255, .2);
  --font-script: 'Dancing Script', 'Brush Script MT', 'Segoe Script', cursive;
  --font-body: 'Poppins', 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
  --ease-soft: cubic-bezier(.22, 1, .36, 1);
  --ease-bounce: cubic-bezier(.34, 1.56, .64, 1);
}

*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; height: 100%; overflow: hidden; }

body {
  font-family: var(--font-body);
  color: var(--text);
  background: var(--night-1);
  -webkit-tap-highlight-color: transparent;
}

/* =========================================================
   2. BACKGROUNDS — sad night sky ⇄ warm sunrise
   ========================================================= */
.bg { position: fixed; inset: 0; pointer-events: none; transition: opacity 2.4s ease; }
.bg-sad {
  z-index: 0;
  background:
    radial-gradient(60vmax 40vmax at 50% 110%, rgba(90, 70, 140, .55), transparent 70%),
    linear-gradient(180deg, #0e1027 0%, #1c1b3a 45%, #2e2550 80%, #3a2d5c 100%);
}
body.deep .bg-sad { filter: brightness(.8) saturate(.85); }
.bg-happy {
  z-index: 0; opacity: 0;
  background: linear-gradient(160deg, #ffd1dc 0%, #ffb3c9 30%, #e5ccff 65%, #fff1e6 100%);
}
body.happy .bg-happy { opacity: 1; }
body.happy .bg-sad   { opacity: 0; }

/* moon */
.moon {
  position: fixed; z-index: 0; top: 9vh; left: 12vw;
  width: 74px; height: 74px; border-radius: 50%;
  background: radial-gradient(circle at 38% 38%, #fffbe8, #e7e2ff 60%, #b9b2e8);
  box-shadow: 0 0 40px 10px rgba(220, 215, 255, .25), 0 0 120px 40px rgba(160, 150, 230, .15);
  opacity: .85;
  pointer-events: none;
  transition: opacity 2s ease, transform 2.4s ease;
}
body.happy .moon { opacity: 0; transform: translateY(-40px); }

/* drifting fog */
.fog {
  position: fixed; z-index: 0; left: -20vw; width: 140vw; height: 30vh;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(190, 180, 240, .14), transparent 70%);
  filter: blur(10px);
  pointer-events: none;
  animation: fog 28s ease-in-out infinite alternate;
  transition: opacity 2s ease;
}
.fog.f1 { bottom: 4vh; }
.fog.f2 { bottom: 26vh; animation-duration: 36s; animation-delay: -12s; opacity: .7; }
body.happy .fog { opacity: 0; }
@keyframes fog { from { transform: translateX(-8vw); } to { transform: translateX(8vw); } }

/* rain + hearts canvas (behind cards, never blocks clicks) */
#fx { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
#burst { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 120; pointer-events: none; }

/* floating hearts for the happy ending */
#heartsLayer { position: fixed; inset: 0; z-index: 1; overflow: hidden; pointer-events: none; }
.float-heart {
  position: absolute; top: 0;
  animation: floatUp linear both;
  filter: drop-shadow(0 2px 4px rgba(209, 42, 92, .25));
}
@keyframes floatUp {
  0%   { transform: translate3d(0, 105vh, 0) rotate(0deg); opacity: 0; }
  10%  { opacity: .9; }
  100% { transform: translate3d(var(--drift, 0px), -12vh, 0) rotate(var(--spin, 0deg)); opacity: 0; }
}

/* =========================================================
   3. TOP BAR: progress dots, music button, toast
   ========================================================= */
#progress {
  position: fixed; top: 22px; left: 16px; z-index: 110;
  display: flex; gap: 8px;
  transition: opacity .6s ease;
}
#progress span {
  width: 9px; height: 9px; border-radius: 50%;
  background: rgba(255, 255, 255, .25);
  transition: background .4s ease, transform .4s ease;
}
#progress span.done { background: var(--rose); }
#progress span.now  { background: #fff; transform: scale(1.35); }
body.happy #progress { opacity: 0; }

#musicBtn {
  position: fixed; top: 12px; right: 14px; z-index: 110;
  width: 48px; height: 48px;
  display: grid; place-items: center;
  border-radius: 50%;
  border: 1px solid var(--glass-border);
  background: rgba(255, 255, 255, .12);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  color: #fff; font-size: 20px; line-height: 1;
  cursor: pointer;
  transition: transform .2s ease, background .6s ease;
}
#musicBtn:hover { transform: scale(1.08); }
#musicBtn:focus-visible { outline: 3px solid var(--rose); outline-offset: 3px; }
#musicBtn:disabled { opacity: .5; cursor: not-allowed; }
body.happy #musicBtn { background: rgba(255, 255, 255, .6); border-color: #fff; }

#toast {
  position: fixed; top: 14px; left: 50%; z-index: 115;
  max-width: min(420px, calc(100vw - 150px));
  padding: 11px 16px;
  border-radius: 16px;
  background: rgba(255, 255, 255, .92);
  color: #3b2346;
  font-weight: 600; font-size: .95rem; line-height: 1.35; text-align: center;
  box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
  transform: translate(-50%, -160%); opacity: 0;
  pointer-events: none;
  transition: transform .45s var(--ease-bounce), opacity .3s ease;
}
#toast.show { transform: translate(-50%, 0); opacity: 1; }

/* =========================================================
   4. SCREENS + GLASS CARD
   ========================================================= */
.screen {
  position: fixed; inset: 0; z-index: 2;
  display: flex; flex-direction: column;
  overflow-x: hidden; overflow-y: auto;
  padding: 74px 16px 36px;
  opacity: 0; visibility: hidden;
  transform: translateY(14px);
  transition: opacity .9s ease, transform .9s var(--ease-soft), visibility 0s linear .9s;
}
.screen.is-active {
  opacity: 1; visibility: visible; transform: none;
  transition: opacity .9s ease .15s, transform .9s var(--ease-soft) .15s, visibility 0s;
}

.card {
  position: relative;
  margin: auto;
  width: min(100%, 560px);
  padding: clamp(22px, 5vw, 38px);
  border-radius: 30px;
  background: linear-gradient(150deg, rgba(255, 255, 255, .11), rgba(255, 255, 255, .04));
  border: 1px solid var(--glass-border);
  -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
  box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
  text-align: center;
}
.card.wide { width: min(100%, 660px); }
.card.light {
  color: #4a1531;
  background: linear-gradient(145deg, rgba(255, 255, 255, .7), rgba(255, 255, 255, .4));
  border-color: rgba(255, 255, 255, .8);
  box-shadow: 0 24px 60px rgba(168, 18, 74, .18);
}

.fade-up { opacity: 0; }
.screen.is-active .fade-up { animation: fadeUp 1s var(--ease-soft) both; }
.screen.is-active .d1 { animation-delay: .3s; }
.screen.is-active .d2 { animation-delay: .55s; }
.screen.is-active .d3 { animation-delay: .8s; }
.screen.is-active .d4 { animation-delay: 1.05s; }
.screen.is-active .d5 { animation-delay: 1.3s; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

/* =========================================================
   5. TYPOGRAPHY
   ========================================================= */
[tabindex="-1"]:focus { outline: none; }
h1, h2 { font-family: var(--font-script); font-weight: 700; margin: .2em 0 .35em; line-height: 1.2; }
h1 { font-size: clamp(2.1rem, 8vw, 3.1rem); }
h2 { font-size: clamp(1.9rem, 7vw, 2.6rem); }
.card:not(.light) h1, .card:not(.light) h2 {
  color: #ffe1ea;
  text-shadow: 0 0 18px rgba(255, 143, 171, .35);
}
.card.light h1 { color: #a8124a; text-shadow: 0 2px 0 rgba(255, 255, 255, .9); }
.lead {
  max-width: 30em; margin: 0 auto 1.2em;
  font-size: clamp(.98rem, 2.8vw, 1.08rem);
  line-height: 1.75;
  color: var(--text-soft);
}
.card.light .lead { color: #6b2a4a; }
.hint { font-size: .88rem; color: var(--mist); margin: .9em 0 0; min-height: 1.4em; }

/* =========================================================
   6. BUTTONS
   ========================================================= */
.btn-row { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 18px; }
.btn {
  min-height: 52px;
  padding: 14px 26px;
  border-radius: 999px;
  border: 0;
  font: 600 clamp(.98rem, 3.4vw, 1.08rem)/1.2 var(--font-body);
  cursor: pointer;
  touch-action: manipulation;
  transition: transform .25s ease, box-shadow .25s ease, opacity .4s ease, filter .25s ease;
}
.btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; box-shadow: 0 0 0 7px var(--rose-deep); }
.btn:hover:not(:disabled) { transform: translateY(-2px); }
.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #ff8fab, #e05a83 55%, #b83b6c);
  box-shadow: 0 10px 26px rgba(224, 90, 131, .4), inset 0 1px 0 rgba(255, 255, 255, .35);
}
.btn-primary.pulse { animation: softPulse 2.4s ease-in-out infinite; }
@keyframes softPulse {
  0%, 100% { box-shadow: 0 10px 26px rgba(224, 90, 131, .4), 0 0 0 0 rgba(255, 143, 171, .4); }
  50%      { box-shadow: 0 10px 26px rgba(224, 90, 131, .4), 0 0 0 12px rgba(255, 143, 171, 0); }
}
.btn-ghost {
  color: var(--text);
  background: rgba(255, 255, 255, .08);
  border: 1.5px solid rgba(255, 255, 255, .35);
}
.btn:disabled { opacity: .4; cursor: not-allowed; filter: grayscale(.4); }
.btn.hidden-until { visibility: hidden; opacity: 0; }
.btn.hidden-until.show { visibility: visible; opacity: 1; animation: fadeUp .7s var(--ease-soft) both; }

.link-btn {
  margin-top: 14px; padding: 8px 12px;
  border: 0; border-radius: 10px; background: none;
  color: inherit; opacity: .75;
  font: 500 .9rem var(--font-body);
  text-decoration: underline; text-underline-offset: 3px;
  cursor: pointer;
}
.link-btn:focus-visible { outline: 3px solid var(--rose-deep); outline-offset: 2px; }

/* Response bubble used on screens 1 & 2 */
.reply {
  margin: 16px auto 0; max-width: 28em;
  padding: 0 4px;
  font-size: 1.02rem; line-height: 1.6;
  color: #ffe1ea;
  min-height: 1.6em;
}
.reply:not(:empty) { animation: fadeUp .6s var(--ease-soft) both; }

/* =========================================================
   7. CSS ILLUSTRATION — sad boy holding a "Sorry" sign
   ========================================================= */
.sad-boy { position: relative; width: 150px; height: 200px; margin: 0 auto 4px; animation: sway 4s ease-in-out infinite; }
@keyframes sway { 0%, 100% { transform: rotate(-1.5deg); } 50% { transform: rotate(1.5deg) translateY(-3px); } }
.sad-boy .head {
  position: absolute; left: 41px; top: 6px; z-index: 3;
  width: 68px; height: 66px; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #fff0e4 0%, #ffd9bf 45%, #eab08b 100%);
  box-shadow: inset -5px -7px 12px rgba(200, 110, 80, .25);
}
.sad-boy .hair {
  position: absolute; left: -3px; top: -7px; width: 74px; height: 28px;
  border-radius: 36px 36px 12px 18px;
  background: linear-gradient(160deg, #6b4030, #3d2218);
}
.sad-boy .hair::after {
  content: ""; position: absolute; left: 10px; bottom: -5px; width: 24px; height: 11px;
  border-radius: 0 0 12px 12px; background: #4a2a1d; transform: rotate(10deg);
}
.sad-boy .brow {
  position: absolute; top: 26px; width: 13px; height: 3px; border-radius: 3px; background: #4a2a1d;
}
.sad-boy .brow.l { left: 15px; transform: rotate(-16deg); }
.sad-boy .brow.r { right: 15px; transform: rotate(16deg); }
.sad-boy .eye {
  position: absolute; top: 32px; width: 12px; height: 13px; border-radius: 50%;
  background: #2b1722;
  animation: blink 5s infinite;
}
.sad-boy .eye::before { content: ""; position: absolute; top: 2px; left: 2px; width: 5px; height: 5px; border-radius: 50%; background: #fff; }
.sad-boy .eye::after  { content: ""; position: absolute; bottom: 2px; right: 2px; width: 2.5px; height: 2.5px; border-radius: 50%; background: #fff; }
.sad-boy .eye.l { left: 16px; }
.sad-boy .eye.r { right: 16px; }
@keyframes blink { 0%, 93%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
.sad-boy .cheek { position: absolute; top: 45px; width: 12px; height: 6px; border-radius: 50%; background: rgba(255, 105, 140, .45); }
.sad-boy .cheek.l { left: 7px; }
.sad-boy .cheek.r { right: 7px; }
.sad-boy .mouth {
  position: absolute; top: 50px; left: 50%; width: 14px; height: 7px;
  transform: translateX(-50%);
  border: 2.5px solid #9b2c4a; border-bottom: 0;
  border-radius: 14px 14px 0 0;
}
.sad-boy .tear {
  position: absolute; left: 18px; top: 44px; width: 8px; height: 12px;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  background: linear-gradient(180deg, #d6efff, #79c2f7);
  animation: tear 2.4s ease-in infinite;
}
.sad-boy .tear.r { left: auto; right: 18px; animation-delay: -1.2s; }
@keyframes tear {
  0%   { transform: translateY(0) scale(.5); opacity: 0; }
  20%  { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(30px) scale(.8); opacity: 0; }
}
.sad-boy .shirt {
  position: absolute; left: 44px; top: 66px; z-index: 1;
  width: 62px; height: 74px; border-radius: 22px 22px 12px 12px;
  background: linear-gradient(160deg, #8fa3e8, #5468c4);
}
.sad-boy .sign {
  position: absolute; left: 22px; top: 86px; z-index: 4;
  width: 106px; padding: 10px 6px;
  border-radius: 10px;
  background: #fff8f1;
  border: 2px solid #e8c9a8;
  box-shadow: 0 6px 14px rgba(0, 0, 0, .25);
  color: #b83b6c;
  font: 700 1.25rem/1 var(--font-script);
  transform: rotate(-4deg);
  animation: signTilt 3.2s ease-in-out infinite;
}
@keyframes signTilt { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(3deg); } }
.sad-boy .hand {
  position: absolute; top: 98px; z-index: 5;
  width: 15px; height: 15px; border-radius: 50%;
  background: #f7c6a3;
}
.sad-boy .hand.l { left: 16px; }
.sad-boy .hand.r { right: 16px; }
.sad-boy .leg {
  position: absolute; top: 136px; width: 14px; height: 46px; border-radius: 6px;
  background: #3b335e; border-bottom: 8px solid #221c3a;
}
.sad-boy .leg.l { left: 56px; }
.sad-boy .leg.r { right: 56px; }
.sad-boy .shadow {
  position: absolute; bottom: 4px; left: 50%; width: 120px; height: 14px;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(0, 0, 0, .35), transparent 70%);
}
.sad-boy .cloud {
  position: absolute; top: -26px; right: -10px; font-size: 30px;
  animation: cloud 3s ease-in-out infinite;
}
@keyframes cloud { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

/* =========================================================
   8. SCREEN 2 — mood buttons
   ========================================================= */
.moods { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 8px; }
.mood {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding: 16px 10px;
  border-radius: 20px;
  border: 1.5px solid rgba(255, 255, 255, .22);
  background: rgba(255, 255, 255, .06);
  color: var(--text);
  font: 500 .95rem/1.3 var(--font-body);
  cursor: pointer;
  transition: transform .25s var(--ease-bounce), background .3s ease, border-color .3s ease;
}
.mood .emo { font-size: 2.2rem; line-height: 1; transition: transform .4s var(--ease-bounce); }
.mood:hover { transform: translateY(-3px); background: rgba(255, 255, 255, .1); }
.mood:hover .emo { transform: scale(1.15) rotate(-6deg); }
.mood[aria-pressed="true"] { border-color: var(--rose); background: rgba(255, 143, 171, .16); }
.mood:focus-visible { outline: 3px solid var(--rose); outline-offset: 3px; }

/* =========================================================
   9. SCREEN 3 — flip cards
   ========================================================= */
.flips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 6px; }
.flip {
  position: relative;
  min-height: 132px;
  padding: 0; border: 0; background: none;
  cursor: pointer;
  perspective: 900px;
  color: inherit; font: inherit;
}
.flip:focus-visible { outline: 3px solid var(--rose); outline-offset: 4px; border-radius: 20px; }
.flip-inner {
  position: absolute; inset: 0;
  transform-style: preserve-3d;
  transition: transform .8s var(--ease-soft);
}
.flip.flipped .flip-inner { transform: rotateY(180deg); }
.flip-face {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  padding: 12px;
  border-radius: 20px;
  -webkit-backface-visibility: hidden; backface-visibility: hidden;
}
.flip-front {
  background: linear-gradient(150deg, rgba(255, 255, 255, .14), rgba(255, 255, 255, .05));
  border: 1.5px dashed rgba(255, 255, 255, .35);
  font-size: .9rem; color: var(--mist);
}
.flip-front .emo { font-size: 2rem; animation: wiggle 2.6s ease-in-out infinite; }
@keyframes wiggle { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
.flip-back {
  transform: rotateY(180deg);
  background: linear-gradient(150deg, #fff3f6, #ffe1ea);
  color: #5a1f3c;
  font-size: .93rem; line-height: 1.5; font-weight: 500;
  box-shadow: 0 10px 24px rgba(0, 0, 0, .25);
}

/* =========================================================
   10. SCREEN 4 — promises (mend the broken hearts)
   ========================================================= */
.promises { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 10px; }
.promise {
  width: 100%;
  display: flex; align-items: center; gap: 14px;
  padding: 13px 16px;
  border-radius: 18px;
  border: 1.5px solid rgba(255, 255, 255, .22);
  background: rgba(255, 255, 255, .06);
  color: var(--text);
  font: 500 .97rem/1.45 var(--font-body);
  text-align: left;
  cursor: pointer;
  transition: background .4s ease, border-color .4s ease, transform .25s ease;
}
.promise:hover { transform: translateX(3px); }
.promise:focus-visible { outline: 3px solid var(--rose); outline-offset: 3px; }
.promise .heart { font-size: 1.7rem; line-height: 1; flex: none; transition: transform .5s var(--ease-bounce); }
.promise .ptext { opacity: .7; }
.promise.mended { background: rgba(255, 143, 171, .15); border-color: rgba(255, 143, 171, .7); cursor: default; }
.promise.mended .heart { animation: mend .7s var(--ease-bounce); }
.promise.mended .ptext { opacity: 1; animation: fadeUp .6s var(--ease-soft) both; }
@keyframes mend { 0% { transform: scale(.4) rotate(-20deg); } 60% { transform: scale(1.35); } 100% { transform: scale(1); } }

/* =========================================================
   11. SCREEN 5 — the long letter
   ========================================================= */
.broken-heart { font-size: 46px; line-height: 1; animation: beatSlow 2.6s ease-in-out infinite; }
@keyframes beatSlow { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.12); } 30% { transform: scale(1); } }
.letter {
  position: relative;
  margin-top: 8px;
  padding: clamp(20px, 4.5vw, 32px);
  border-radius: 20px;
  text-align: left;
  color: #3f2236;
  background: linear-gradient(170deg, #fffaf4, #f7ecf3);
  box-shadow: 0 18px 40px rgba(0, 0, 0, .35), inset 0 0 40px rgba(220, 190, 220, .35);
  font-size: clamp(.98rem, 2.7vw, 1.05rem);
  line-height: 1.85;
}
.letter::before {
  content: "🥀";
  position: absolute; top: -16px; right: 18px; font-size: 30px;
  transform: rotate(18deg);
}
.letter p { margin: 0 0 1em; opacity: 0; }
.screen.is-active .letter p { animation: fadeUp 1.2s var(--ease-soft) both; animation-delay: calc(var(--i, 0) * .5s + .6s); }
.letter .greet { font-family: var(--font-script); font-size: 1.7rem; font-weight: 700; color: #a8124a; line-height: 1.3; }
.letter .strong { font-weight: 600; color: #a8124a; }
.letter .sign {
  font-family: var(--font-script); font-weight: 700;
  font-size: clamp(1.6rem, 6vw, 2rem); color: #a8124a;
  text-align: right; line-height: 1.3; margin-bottom: 0;
}

/* =========================================================
   12. SCREEN 6 — forgiven (couple hug)
   ========================================================= */
.couple { position: relative; width: 230px; height: 176px; margin: 0 auto; }
.couple .person { position: absolute; bottom: 8px; width: 80px; height: 156px; }
.couple .boy  { left: 32px; animation: boyIn 1.6s var(--ease-soft) both, bob 3.2s ease-in-out 1.6s infinite; }
.couple .girl { right: 32px; animation: girlIn 1.6s var(--ease-soft) both, bob 3.2s ease-in-out 1.6s infinite; }
@keyframes boyIn  { from { translate: -60px 0; rotate: 0deg; } to { translate: 8px 0; rotate: 7deg; } }
@keyframes girlIn { from { translate: 60px 0; rotate: 0deg; } to { translate: -8px 0; rotate: -7deg; } }
