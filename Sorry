<script>
(function () {
  'use strict';

  /* ---------------------------------------------------------
     ✏️ EASY CUSTOMISATION
     Put her name or a pet name here (e.g. 'Riya' or 'Jaan').
     Leave it empty to keep the default words ("you" / "love").
     --------------------------------------------------------- */
  const HER_NAME = '';

  /* ---------------------------------------------------------
     Helpers & environment checks
     --------------------------------------------------------- */
  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
  const rand = (a, b) => a + Math.random() * (b - a);
  const pick = a => a[Math.floor(Math.random() * a.length)];
  const mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let reduceMotion = mqReduce.matches;
  if (mqReduce.addEventListener) mqReduce.addEventListener('change', e => { reduceMotion = e.matches; });

  if (HER_NAME.trim()) $$('.her-name').forEach(el => { el.textContent = HER_NAME.trim(); });

  /* ---------------------------------------------------------
     Toast: short gentle messages at the top
     --------------------------------------------------------- */
  const toast = $('#toast');
  let toastTimer = null;
  function showToast(msg, ms) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), ms || 2800);
  }

  /* ---------------------------------------------------------
     RAIN (canvas): soft diagonal drops while she's sad.
     Gets heavier during the letter, stops when she forgives.
     --------------------------------------------------------- */
  const fx = $('#fx');
  const fctx = fx.getContext('2d');
  let drops = [];
  let rainLevel = 1;        // 0 = off, 1 = drizzle, 1.6 = heavier
  let rainRaf = null;

  function sizeCanvases() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    [fx, burstCanvas].forEach(c => {
      c.width = Math.floor(window.innerWidth * dpr);
      c.height = Math.floor(window.innerHeight * dpr);
      c.getContext('2d').setTransform(dpr, 0, 0, dpr, 0, 0);
    });
  }

  function makeDrop(anyY) {
    const W = window.innerWidth, H = window.innerHeight;
    return {
      x: rand(-60, W + 20),
      y: anyY ? rand(-H, H) : rand(-120, -10),
      len: rand(10, 22),
      speed: rand(7, 12),
      alpha: rand(.12, .32)
    };
  }

  /** Animation loop for the rain; it pauses itself when rain is off. */
  function rainTick() {
    const W = window.innerWidth, H = window.innerHeight;
    fctx.clearRect(0, 0, W, H);
    const target = reduceMotion ? 0 : Math.round(Math.min(160, W / 7) * rainLevel);
    while (drops.length < target) drops.push(makeDrop(true));
    if (drops.length > target) drops.length = target;
    fctx.lineCap = 'round';
    fctx.lineWidth = 1.2;
    for (const d of drops) {
      d.x += d.speed * 0.22;
      d.y += d.speed;
      if (d.y > H + 20) Object.assign(d, makeDrop(false));
      fctx.strokeStyle = `rgba(200, 205, 255, ${d.alpha})`;
      fctx.beginPath();
      fctx.moveTo(d.x, d.y);
      fctx.lineTo(d.x - d.len * 0.22, d.y - d.len);
      fctx.stroke();
    }
    if (target > 0 && !document.hidden) rainRaf = requestAnimationFrame(rainTick);
    else { rainRaf = null; fctx.clearRect(0, 0, W, H); }
  }
  function startRain() { if (!rainRaf) rainRaf = requestAnimationFrame(rainTick); }
  document.addEventListener('visibilitychange', () => { if (!document.hidden && rainLevel > 0) startRain(); });

  /* ---------------------------------------------------------
     HEART BURSTS (canvas): used when hearts are mended and
     for the happy ending.
     --------------------------------------------------------- */
  const burstCanvas = $('#burst');
  const bctx = burstCanvas.getContext('2d');
  const COLORS = ['#ff4d79', '#ff8fab', '#ffd166', '#c8b6ff', '#ffffff', '#e63e6d', '#ffb3c9'];
  let parts = [];
  let burstRaf = null;

  function drawHeart(c, s) {
    c.beginPath();
    c.moveTo(0, s * .3);
    c.bezierCurveTo(0, 0, -s / 2, 0, -s / 2, s * .3);
    c.bezierCurveTo(-s / 2, s * .6, 0, s * .8, 0, s);
    c.bezierCurveTo(0, s * .8, s / 2, s * .6, s / 2, s * .3);
    c.bezierCurveTo(s / 2, 0, 0, 0, 0, s * .3);
    c.fill();
  }

  /** Explosion of hearts + confetti from a point. */
  function burst(x, y, n) {
    n = reduceMotion ? Math.round(n / 5) : n;
    for (let i = 0; i < n; i++) {
      const a = rand(0, Math.PI * 2), sp = rand(3, 11);
      parts.push({
        x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 3, g: rand(.15, .24),
        rot: rand(0, 6.3), vr: rand(-.2, .2), size: rand(6, 13),
        color: pick(COLORS), heart: Math.random() < .55, life: 0, max: rand(90, 160)
      });
    }
    if (!burstRaf) burstRaf = requestAnimationFrame(burstTick);
  }

  function burstTick() {
    const W = window.innerWidth, H = window.innerHeight;
    bctx.clearRect(0, 0, W, H);
    for (let i = parts.length - 1; i >= 0; i--) {
      const p = parts[i];
      p.vx *= .985; p.vy = p.vy * .99 + p.g;
      p.x += p.vx; p.y += p.vy; p.rot += p.vr; p.life++;
      const fade = p.max * .7;
      const alpha = p.life < fade ? 1 : 1 - (p.life - fade) / (p.max - fade);
      if (alpha <= 0 || p.y > H + 40) { parts.splice(i, 1); continue; }
      bctx.save();
      bctx.globalAlpha = alpha;
      bctx.translate(p.x, p.y);
      bctx.rotate(p.rot);
      bctx.fillStyle = p.color;
      if (p.heart) { bctx.translate(0, -p.size / 2); drawHeart(bctx, p.size * 1.3); }
      else bctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
      bctx.restore();
    }
    if (parts.length) burstRaf = requestAnimationFrame(burstTick);
    else { burstRaf = null; bctx.clearRect(0, 0, W, H); }
  }

  sizeCanvases();
  startRain();
  window.addEventListener('resize', sizeCanvases);

  /* ---------------------------------------------------------
     Floating hearts for the happy ending
     --------------------------------------------------------- */
  const heartsLayer = $('#heartsLayer');
  let heartsOn = false;
  function spawnHeart() {
    if (!heartsOn || document.hidden || reduceMotion) return;
    const el = document.createElement('span');
    el.className = 'float-heart';
    el.textContent = pick(['❤️', '💕', '💖', '💗', '🌸', '✨']);
    el.style.left = rand(0, 96) + '%';
    el.style.fontSize = rand(14, 28) + 'px';
    const dur = rand(8, 14);
    el.style.animationDuration = dur + 's';
    el.style.setProperty('--drift', rand(-60, 60) + 'px');
    el.style.setProperty('--spin', rand(-40, 40) + 'deg');
    heartsLayer.appendChild(el);
    setTimeout(() => el.remove(), dur * 1000 + 100);
  }
  setInterval(spawnHeart, 600);

  /* ---------------------------------------------------------
     MUSIC — composed live in the browser with the Web Audio API
     (no files to fail). Two moods:
       'sad'   → slow A-minor piano with soft rain noise
       'happy' → light C-major music box (after she forgives)
     Starts only after her first tap/click (autoplay rules).
     --------------------------------------------------------- */
  const Music = (function () {
    const AC = window.AudioContext || window.webkitAudioContext;
    let ac, master, bus, rainGain, timer;
    let started = false, muted = false, nextTime = 0, step = 0, mode = 'sad';
    const VOL = 0.75;
    const midi = n => 440 * Math.pow(2, (n - 69) / 12);

    const SONGS = {
      sad: {
        step: 0.46,
        chords: [[45, 52, 57, 60], [41, 48, 53, 57], [48, 55, 60, 64], [43, 50, 55, 59]],   // Am – F – C – G
        arp: [0, 2, 3, 2, 1, 2, 3, 2],
        melody: [76, 0, 0, 74, 72, 0, 71, 0,
                 72, 0, 0, 69, 69, 0, 0, 0,
                 72, 0, 74, 0, 76, 0, 77, 76,
                 74, 0, 0, 72, 71, 0, 0, 0],
        arpVol: 0.04, melVol: 0.075
      },
      happy: {
        step: 0.32,
        chords: [[48, 55, 60, 64], [45, 52, 57, 60], [41, 48, 53, 57], [43, 50, 55, 59]],   // C – Am – F – G
        arp: [0, 1, 2, 3, 2, 1, 2, 3],
        melody: [76, 0, 79, 0, 77, 76, 74, 0,
                 72, 0, 76, 0, 74, 72, 71, 0,
                 69, 0, 72, 0, 77, 76, 74, 0,
                 74, 0, 71, 0, 74, 76, 79, 0],
        arpVol: 0.045, melVol: 0.085
      }
    };

    /** One soft piano-like note. */
    function note(freq, t, dur, vol, type) {
      const o = ac.createOscillator(), g = ac.createGain();
      o.type = type;
      o.frequency.setValueAtTime(freq, t);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + 0.02);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g); g.connect(bus);
      o.start(t); o.stop(t + dur + 0.05);
    }

    function playStep(s, t) {
      const song = SONGS[mode];
      const bar = Math.floor(s / 8) % 4, beat = s % 8;
      const chord = song.chords[bar];
      note(midi(chord[song.arp[beat]]), t, mode === 'sad' ? 1.8 : 0.9, song.arpVol, 'triangle');
      if (beat === 0) note(midi(chord[0] - 12), t, 3.2, 0.06, 'sine');
      const m = song.melody[s % 32];
      if (m) {
        note(midi(m), t, mode === 'sad' ? 2.2 : 1.3, song.melVol, 'sine');
        note(midi(m) * 2, t, 0.5, 0.01, 'sine');
      }
    }

    function scheduler() {
      while (nextTime < ac.currentTime + 0.25) {
        playStep(step, nextTime);
        nextTime += SONGS[mode].step;
        step = (step + 1) % 32;
      }
    }

    /** Gentle rain hiss made from filtered noise. */
    function makeRain() {
      const len = ac.sampleRate * 2;
      const buf = ac.createBuffer(1, len, ac.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
      const src = ac.createBufferSource();
      src.buffer = buf; src.loop = true;
      const hp = ac.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 900;
      const lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 5000;
      rainGain = ac.createGain();
      rainGain.gain.value = mode === 'sad' ? 0.035 : 0;
      src.connect(hp); hp.connect(lp); lp.connect(rainGain); rainGain.connect(master);
      src.start();
    }

    function start() {
      if (started) return true;
      if (!AC) return false;
      try {
        ac = new AC();
        master = ac.createGain(); master.gain.value = 0; master.connect(ac.destination);
        bus = ac.createGain(); bus.connect(master);
        // soft echo for a dreamy, lonely feel
        const delay = ac.createDelay(); delay.delayTime.value = 0.36;
        const fb = ac.createGain(); fb.gain.value = 0.35;
        const lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 1800;
        const wet = ac.createGain(); wet.gain.value = 0.4;
        bus.connect(delay); delay.connect(fb); fb.connect(delay);
        delay.connect(lp); lp.connect(wet); wet.connect(master);
        makeRain();
        if (ac.state === 'suspended') ac.resume();
        nextTime = ac.currentTime + 0.1; step = 0;
        timer = setInterval(scheduler, 70);
        master.gain.setTargetAtTime(VOL, ac.currentTime, 1.2);
        started = true;
      } catch (err) {
        console.warn('Music unavailable:', err);
      }
      return started;
    }

    function toggle() {
      if (!started) return start();
      muted = !muted;
      if (!muted && ac.state === 'suspended') ac.resume();
      master.gain.setTargetAtTime(muted ? 0 : VOL, ac.currentTime, 0.2);
      return true;
    }

    /** Switch between the sad and happy songs with a short fade. */
    function setMode(m) {
      if (mode === m) return;
      mode = m;
      if (!started) return;
      const t = ac.currentTime;
      if (!muted) {
        master.gain.setTargetAtTime(0.0001, t, 0.25);
        master.gain.setTargetAtTime(VOL, t + 1.1, 0.6);
      }
      nextTime = t + 1.1; step = 0;
      rainGain.gain.setTargetAtTime(m === 'sad' ? 0.035 : 0, t, 0.8);
    }

    document.addEventListener('visibilitychange', () => {
      if (!ac) return;
      if (document.hidden) ac.suspend(); else if (!muted) ac.resume();
    });

    return { available: !!AC, start, toggle, setMode, isStarted: () => started, isMuted: () => muted };
  })();

  const musicBtn = $('#musicBtn');
  /** Keep the music button's icon and label in sync with the audio state. */
  function updateMusicBtn() {
    let icon = '🎵', label = 'Play music', pressed = false;
    if (!Music.available) { musicBtn.disabled = true; label = 'Music is not supported in this browser'; }
    else if (Music.isStarted() && Music.isMuted()) { icon = '🔇'; label = 'Unmute music'; }
    else if (Music.isStarted()) { icon = '🔊'; label = 'Mute music'; pressed = true; }
    musicBtn.textContent = icon;
    musicBtn.title = label;
    musicBtn.setAttribute('aria-label', label);
    musicBtn.setAttribute('aria-pressed', String(pressed));
  }
  updateMusicBtn();
  musicBtn.addEventListener('click', () => { Music.toggle(); updateMusicBtn(); });

  // Start the sad music on her very first interaction anywhere.
  function firstGesture(e) {
    if (e.target.closest && e.target.closest('#musicBtn')) return;
    if (e.type === 'keydown' && ['Tab', 'Shift', 'Escape'].includes(e.key)) return;
    ['pointerdown', 'keydown'].forEach(t => window.removeEventListener(t, firstGesture, true));
    Music.start(); updateMusicBtn();
  }
  ['pointerdown', 'keydown'].forEach(t => window.addEventListener(t, firstGesture, true));

  /* ---------------------------------------------------------
     SCREENS — fade between steps and update the progress dots
     --------------------------------------------------------- */
  const screens = $$('.screen');
  const dots = $$('#progress span');

  function go(id) {
    screens.forEach(s => {
      const on = s.id === id;
      s.classList.toggle('is-active', on);
      s.toggleAttribute('inert', !on);
      s.setAttribute('aria-hidden', String(!on));
      if (on) s.scrollTop = 0;
    });
    const idx = Number(id.slice(1)) - 1;
    dots.forEach((d, i) => {
      d.classList.toggle('done', i < idx);
      d.classList.toggle('now', i === idx);
    });
    // The letter gets a deeper, rainier mood
    document.body.classList.toggle('deep', id === 's5');
    rainLevel = id === 's6' ? 0 : id === 's5' ? 1.6 : 1;
    if (rainLevel > 0) startRain();
    // move keyboard focus to the new heading
    const h = $('#' + id + ' h1, #' + id + ' h2');
    if (h) { h.setAttribute('tabindex', '-1'); setTimeout(() => h.focus({ preventScroll: true }), 700); }
  }
  go('s1');

  $$('[data-next]').forEach(btn => btn.addEventListener('click', () => go(btn.dataset.next)));

  /* ---------------------------------------------------------
     SCREEN 1 — "I'm still angry" gets a gentle reply
     --------------------------------------------------------- */
  const ANGRY_REPLIES = [
    "That's okay. You're allowed to be. I'll wait right here. 🥺",
    "I know… and I'm so sorry. Just a few minutes? 🙏",
    "Even when you're angry, you're still my favourite person. 💔",
    "I'll keep saying sorry until that frown softens. 🥹"
  ];
  let angryCount = 0;
  $('#stillAngry').addEventListener('click', () => {
    $('#reply1').textContent = ANGRY_REPLIES[angryCount % ANGRY_REPLIES.length];
    angryCount++;
  });

  /* ---------------------------------------------------------
     SCREEN 2 — pick a mood, get a reply, then continue
     --------------------------------------------------------- */
  $$('.mood').forEach(btn => btn.addEventListener('click', () => {
    $$('.mood').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    $('#reply2').textContent = '';
    void $('#reply2').offsetWidth;            // restart the fade-in
    $('#reply2').textContent = btn.dataset.reply;
    $('#next2').classList.add('show');
  }));

  /* ---------------------------------------------------------
     SCREEN 3 — flip every "sorry" card to continue
     --------------------------------------------------------- */
  const flips = $$('.flip');
  flips.forEach((card, i) => card.addEventListener('click', () => {
    if (card.classList.contains('flipped')) return;
    card.classList.add('flipped');
    card.setAttribute('aria-label', 'I am sorry for: ' + $('.flip-back', card).textContent);
    const n = flips.filter(c => c.classList.contains('flipped')).length;
    $('#hint3').textContent = n < flips.length ? `${n} of ${flips.length} opened` : 'Thank you for reading them. 🥺';
    if (n === flips.length) $('#next3').disabled = false;
  }));

  /* ---------------------------------------------------------
     SCREEN 4 — mend every broken heart to reveal the promises
     --------------------------------------------------------- */
  const promises = $$('.promise');
  promises.forEach(btn => btn.addEventListener('click', () => {
    if (btn.classList.contains('mended')) return;
    btn.classList.add('mended');
    $('.heart', btn).textContent = '❤️';
    $('.ptext', btn).textContent = btn.dataset.text;
    const r = $('.heart', btn).getBoundingClientRect();
    burst(r.left + r.width / 2, r.top + r.height / 2, 18);
    const n = promises.filter(p => p.classList.contains('mended')).length;
    $('#hint4').textContent = n < promises.length ? `${n} of ${promises.length} mended` : 'Every promise, I mean it. 🤍';
    if (n === promises.length) $('#next4').disabled = false;
  }));

  /* ---------------------------------------------------------
     SCREEN 5 → 6 — forgiveness turns the rain into sunshine
     --------------------------------------------------------- */
  function forgive(fromEl) {
    Music.start(); Music.setMode('happy'); updateMusicBtn();
    const r = fromEl.getBoundingClientRect();
    burst(r.left + r.width / 2, r.top + r.height / 2, 120);
    document.body.classList.add('happy');
    heartsOn = true;
    go('s6');
    const couple = $('#couple');
    couple.classList.remove('jump');      // restart the hug animation
    $$('.person', couple).forEach(p => { p.style.animation = 'none'; void p.offsetWidth; p.style.animation = ''; });
    const W = window.innerWidth, H = window.innerHeight;
    setTimeout(() => { burst(W * .2, H * .35, 80); burst(W * .8, H * .35, 80); }, 500);
    setTimeout(() => showToast('The rain stopped. ☀️❤️', 3000), 1200);
  }
  $('#forgiveBtn').addEventListener('click', e => forgive(e.currentTarget));

  // "I need some time" → a calm, no-pressure message
  const timeModal = $('#timeModal');
  let lastFocus = null;
  function openModal() {
    lastFocus = document.activeElement;
    timeModal.hidden = false;
    void timeModal.offsetWidth;
    timeModal.classList.add('open');
    $('#timeOk').focus({ preventScroll: true });
  }
  function closeModal() {
    timeModal.classList.remove('open');
    setTimeout(() => { if (!timeModal.classList.contains('open')) timeModal.hidden = true; }, 350);
    if (lastFocus) lastFocus.focus({ preventScroll: true });
  }
  $('#timeBtn').addEventListener('click', openModal);
  $('#timeOk').addEventListener('click', () => { closeModal(); showToast("I'll be here. Whenever you're ready. 🤍", 3200); });
  $('#timeForgive').addEventListener('click', () => { closeModal(); setTimeout(() => forgive($('#forgiveBtn')), 250); });
  timeModal.addEventListener('click', e => { if (e.target === timeModal) closeModal(); });

  /* ---------------------------------------------------------
     SCREEN 6 — hugs and starting over
     --------------------------------------------------------- */
  $('#hugBtn').addEventListener('click', e => {
    const r = e.currentTarget.getBoundingClientRect();
    burst(r.left + r.width / 2, r.top + r.height / 2, 110);
    const couple = $('#couple');
    couple.classList.remove('jump'); void couple.offsetWidth; couple.classList.add('jump');
    showToast(pick(['Hug received! 🤗❤️', 'Biggest, tightest hug back! 🫂', 'Never letting go now 🥹💕']));
  });

  $('#restartBtn').addEventListener('click', () => {
    document.body.classList.remove('happy');
    heartsOn = false;
    Music.setMode('sad');
    flips.forEach(c => { c.classList.remove('flipped'); c.setAttribute('aria-label', 'Flip card'); });
    promises.forEach(p => { p.classList.remove('mended'); $('.heart', p).textContent = '💔'; $('.ptext', p).textContent = 'Tap to mend'; });
    $$('.mood').forEach(b => b.setAttribute('aria-pressed', 'false'));
    $('#reply1').textContent = $('#reply2').textContent = '';
    $('#next2').classList.remove('show');
    $('#next3').disabled = $('#next4').disabled = true;
    $('#hint3').textContent = '0 of 4 opened';
    $('#hint4').textContent = '0 of 5 mended';
    go('s1');
  });

  /* ---------------------------------------------------------
     Keyboard: Esc closes the modal; Tab stays inside it
     --------------------------------------------------------- */
  document.addEventListener('keydown', e => {
    if (!timeModal.classList.contains('open')) return;
    if (e.key === 'Escape') { e.preventDefault(); closeModal(); return; }
    if (e.key === 'Tab') {
      const f = $$('button', timeModal), first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
})();
</script>
</body>
</html>
